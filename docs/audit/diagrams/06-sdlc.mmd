    GATE["<b>KAPI (projeye ozgu)</b><br/>'Ciddi iyilesme olcutu devlog'da<br/><b>ONCEDEN</b> yazilir; saglanmadan<br/>bir sonraki kademeye GECILMEZ'<br/>CONTRIBUTING.md kural 3"]
