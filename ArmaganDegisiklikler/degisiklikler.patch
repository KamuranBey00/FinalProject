+    lf = net.fingers(pidx, cont, T(posf), T(fret0))
+    nll = torch.nn.NLLLoss(ignore_index=-100)
+    return nll(lp.reshape(-1, 6), T(ys).reshape(-1)), nll(lf.reshape(-1, 5), T(yg).reshape(-1))
