+        s, g, fr = d["s"][sl], d["g"][sl], d["fr"][sl]
+        ys[b, :n] = np.where(s >= 0, s, -100)
+        yg[b, :n] = np.where((s >= 0) & (g >= 1) & (fr > 0), g, -100)
+        sel.append((d, sl, n))
+    T = lambda a: torch.as_tensor(a, device=device)
